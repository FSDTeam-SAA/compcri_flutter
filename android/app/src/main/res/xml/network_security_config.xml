<?xml version="1.0" encoding="utf-8"?>
<!--
    Cleartext HTTP is allowed only for development hosts and the Aurox Day
    staging API, which is served over plain HTTP on a bare IP.
    10.0.2.2 is the host machine as seen from the Android emulator.
    Everything else must use HTTPS.

    TODO: drop the 2.25.68.237 exception once api.auroxday.com has a TLS
    certificate; credentials and JWTs are sent in the clear over this host.
    Tracked as QA finding S01.
-->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">10.0.2.2</domain>
        <domain includeSubdomains="false">localhost</domain>
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">2.25.68.237</domain>
    </domain-config>
    <base-config cleartextTrafficPermitted="false"/>
</network-security-config>
